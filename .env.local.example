# 120 = reuse cached audit for 2 hours
# 0 = always crawl fresh
AUDIT_CACHE_TTL_MINUTES=120

# Upstash Redis (production audit cache, scan activity, rate limiting)
# Required on Vercel — serverless filesystem is read-only; local .cache/ is dev-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiting (shared scan activity)
SCAN_RATE_LIMIT_PER_HOUR=10

# Turnstile (captcha for shared scan activity)
ENABLE_TURNSTILE=false
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Live activity feed (homepage) — client flag requires NEXT_PUBLIC_ prefix
NEXT_PUBLIC_ENABLE_ACTIVITY_FEED=false
NEXT_PUBLIC_SCAN_ACTIVITY_POLL_SECONDS=60

# Deprecated alias (use NEXT_PUBLIC_ENABLE_ACTIVITY_FEED)
NEXT_PUBLIC_SCAN_ACTIVITY_TOAST_ENABLED=false

# Comma-separated registrable domains blocked from scanning (not exposed publicly)
BANNED_SCAN_DOMAINS=amazon.com,walmart.com,target.com,homedepot.com,etsy.com

# Server-only token for POST /api/admin/reset (never use NEXT_PUBLIC prefix)
ADMIN_RESET_TOKEN=
